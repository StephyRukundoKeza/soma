# Copy this file to .env and fill in your own key. Never commit .env.
GEMINI_API_KEY=
# Models tried in order; if one is busy, the next one is used
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000
# Embedding model used for search (e5 or labse)
SOMA_EMBED_MODEL=e5
# Use the models already downloaded instead of checking online each time
HF_HUB_OFFLINE=1
# Logins (free Supabase project): Project Settings > API Keys
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only, never share it or put it in the web page
SUPABASE_SECRET_KEY=
# Default session length when a learner is not in a class (teachers set it per class)
SOMA_SESSION_MINUTES=40
# How often the dashboard ETL runs while the server is up (seconds; 0 = off)
SOMA_ETL_EVERY_SECONDS=600
