# Copy this file to .env and fill in your own key. Never commit .env.
GEMINI_API_KEY=
# Models tried in order; if one is busy, the next one is used
GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=25000
# Embedding model used for search (e5 or labse)
SOMA_EMBED_MODEL=e5
# Use the models already downloaded instead of checking online each time
HF_HUB_OFFLINE=1
